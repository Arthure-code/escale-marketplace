@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Lien envoyé";
}

<section class="compte">
    <div class="boite">
        <div class="vide">
            <h1>Vérifiez vos courriels</h1>
            <p class="muet">Si un compte existe pour cette adresse, un lien de réinitialisation vient d'y être envoyé.</p>
            <a class="btn btn-primaire" asp-page="./Login">Retour à la connexion</a>
        </div>
    </div>
</section>
