@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Configurer l'application d'authentification";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div>
    <p>Pour utiliser une application d'authentification, suivez ces étapes :</p>
    <ol class="list">
        <li>
            @* Le libellé de chaque lien nomme l'application et la plateforme :
               quatre liens intitulés « Android » ou « iOS » ne se distinguent
               pas quand on parcourt la page lien par lien. *@
            <p>
                Installez une application d'authentification :
                <a href="https://go.microsoft.com/fwlink/?Linkid=825072">Microsoft Authenticator pour Android</a>,
                <a href="https://go.microsoft.com/fwlink/?Linkid=825073">Microsoft Authenticator pour iOS</a>,
                <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=fr">Google Authenticator pour Android</a>
                ou <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8">Google Authenticator pour iOS</a>.
            </p>
        </li>
        <li>
            <p>Saisissez cette clé <kbd>@Model.SharedKey</kbd> dans votre application d'authentification. Les espaces et la casse n'ont pas d'importance.</p>
            <div id="qrCode"></div>
            <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
        </li>
        <li>
            <p>
                Une fois la clé saisie, votre application d'authentification affiche un code unique.
                Saisissez ce code dans le champ de confirmation ci-dessous.
            </p>
            <div class="row">
                <div class="col-md-6">
                    <form id="send-code" method="post">
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Code" class="form-control" autocomplete="off" placeholder="Saisissez le code."/>
                            <label asp-for="Input.Code" class="control-label form-label">Code de vérification</label>
                            <span asp-validation-for="Input.Code" class="text-danger"></span>
                        </div>
                        <button type="submit" class="w-100 btn btn-lg btn-primary">Vérifier</button>
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    </form>
                </div>
            </div>
        </li>
    </ol>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
