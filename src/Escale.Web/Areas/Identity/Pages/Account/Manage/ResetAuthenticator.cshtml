@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Réinitialiser la clé d'authentification";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <strong>Si vous réinitialisez votre clé, votre application d'authentification ne fonctionnera plus tant que vous ne l'aurez pas reconfigurée.</strong>
    </p>
    <p>
        Cette opération désactive la double authentification jusqu'à ce que vous ayez vérifié votre application.
        Si vous ne terminez pas la configuration, vous risquez de perdre l'accès à votre compte.
    </p>
</div>
<div>
    <form id="reset-authenticator-form" method="post">
        <button id="reset-authenticator-button" class="btn btn-danger" type="submit">Réinitialiser la clé d'authentification</button>
    </form>
</div>
