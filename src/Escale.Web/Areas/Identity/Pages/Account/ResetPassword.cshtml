@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Nouveau mot de passe";
}

<section class="compte">
    <div class="boite">
        <div class="carte-forme">
            <h1>Choisir un nouveau mot de passe</h1>

            <p class="muet sous">Choisissez un mot de passe d'au moins huit caractères.</p>

            <form class="forme" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
                <input asp-for="Input.Code" type="hidden" />
                <div class="champ">
                    <label asp-for="Input.Email">Courriel</label>
                    <input asp-for="Input.Email" autocomplete="username" aria-required="true" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="champ">
                    <label asp-for="Input.Password">Mot de passe</label>
                    <input asp-for="Input.Password" autocomplete="new-password" aria-required="true" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="champ">
                    <label asp-for="Input.ConfirmPassword">Confirmation</label>
                    <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primaire">Enregistrer</button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
