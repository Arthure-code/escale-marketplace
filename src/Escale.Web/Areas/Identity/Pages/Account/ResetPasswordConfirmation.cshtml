@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Mot de passe changé";
}

<section class="compte">
    <div class="boite">
        <div class="vide">
            <h1>Votre mot de passe a été réinitialisé</h1>
            <p class="muet">Vous pouvez maintenant vous connecter avec votre nouveau mot de passe.</p>
            <a class="btn btn-primaire" asp-page="./Login">Se connecter</a>
        </div>
    </div>
</section>
