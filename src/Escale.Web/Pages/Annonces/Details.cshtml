@page "{id:int}"
@model Escale.Web.Pages.Annonces.DetailsModel
@{
    ViewData["Title"] = Model.Annonce.Titre;
    ViewData["Grand"] = true;
    string unite = Model.Annonce.Categorie == CategorieAnnonce.Chambre ? "nuit" : "jour";
}

<section class="sec">
    <div class="env deux-colonnes">
        <div class="pile">
            <p class="petit"><a asp-page="/Index">Retour aux offres</a></p>

            <div class="tete-fiche">
                <span class="badge badge-aqua">@(Model.Annonce.Categorie == CategorieAnnonce.Chambre ? "Chambre" : "Voiture")</span>
                <h1>@Model.Annonce.Titre</h1>
                <p class="muet">Proposé par @(Model.Annonce.Loueur?.NomComplet ?? "un loueur Escale")</p>
            </div>

            <div class="photo-fiche">
                <img src="~/images/@Model.Annonce.Photo" alt="@Model.Annonce.Titre" />
                <form method="post" asp-page-handler="Favori" asp-route-id="@Model.Annonce.Id" class="coeur-forme">
                    <button class="coeur @(Model.EstFavori ? "actif" : "")" type="submit"
                            title="@(Model.EstFavori ? "Retirer des favoris" : "Ajouter aux favoris")"
                            aria-label="@(Model.EstFavori ? "Retirer des favoris" : "Ajouter aux favoris")"
                            aria-pressed="@(Model.EstFavori ? "true" : "false")">
                        <svg class="ico"><use href="#i-coeur" /></svg>
                    </button>
                </form>
            </div>

            <p>@Model.Annonce.Description</p>

            <div>
                <h2 class="titre-section">Ce qui est inclus</h2>
                <partial name="_Equipements" model="Model.Annonce" view-data="ViewData" />
            </div>
        </div>

        <form class="recap" method="post" id="reservation"
              data-prix="@Model.Annonce.PrixJournalier"
              data-unite="@unite">
            <div class="prix">
                <b class="nombre">@Model.Annonce.PrixJournalier $</b>
                <span>@Model.Annonce.Unite</span>
            </div>

            <partial name="_Disponibilite" model="Model.Offre" />

            @if (!string.IsNullOrEmpty(Model.Erreur))
            {
                <p class="avis avis-erreur">@Model.Erreur</p>
            }

            <div class="duo">
                <div class="champ">
                    <label for="debut">Arrivée</label>
                    <input id="debut" name="debut" type="date"
                           value="@Model.DebutChoisi.ToString("yyyy-MM-dd")"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="champ">
                    <label for="fin">Départ</label>
                    <input id="fin" name="fin" type="date"
                           value="@Model.FinChoisi.ToString("yyyy-MM-dd")"
                           min="@Model.DebutChoisi.AddDays(1).ToString("yyyy-MM-dd")" required />
                </div>
            </div>

            <div class="poste">
                <span class="nom" id="detail-calcul">@Model.Annonce.PrixJournalier $ x @Model.NombreDeJours @unite@(Model.NombreDeJours > 1 ? "s" : "")</span>
                <span class="mnt nombre" id="detail-montant">@(Model.Annonce.PrixJournalier * Model.NombreDeJours) $</span>
            </div>

            <div class="total-ligne">
                <span>Total</span>
                <b class="nombre" id="detail-total">@(Model.Annonce.PrixJournalier * Model.NombreDeJours) $</b>
            </div>

            @if (Model.Offre.EstComplete)
            {
                <button class="btn btn-primaire" type="submit" disabled>
                    <svg class="ico"><use href="#i-complet" /></svg> Complet sur ces dates
                </button>
                <p class="aide">Tous les @Model.Offre.Exemplaires(2) sont réservés sur cette période. Choisissez d'autres dates pour voir ce qui se libère.</p>
            }
            else
            {
                <button class="btn btn-primaire" type="submit">
                    <svg class="ico"><use href="#i-panier" /></svg> Ajouter au panier
                </button>
                <p class="aide">Aucun prélèvement à cette étape. Le paiement se fait au moment de la commande.</p>
            }
        </form>
    </div>
</section>

@section Scripts {
    <script src="~/js/reservation.js" asp-append-version="true"></script>
}
