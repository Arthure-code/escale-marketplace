@page
@model CodeStatutModel
@{
    ViewData["Title"] = Model.Code.ToString();
}
<section class="sec">
    <div class="env vide">
        <b class="nombre" style="font-size:52px">@Model.Code</b>
        <h1 style="font-size:24px">@Model.Titre</h1>
        <p class="muet">@Model.Explication</p>
        @if (!string.IsNullOrEmpty(Model.CheminDemande))
        {
            <p class="petit muet">Adresse demandée : <code>@Model.CheminDemande</code></p>
        }
        <a class="btn btn-primaire" asp-page="/Index">Retour à l'accueil</a>
    </div>
</section>
