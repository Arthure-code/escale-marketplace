@page "{id:int?}"
@model Escale.Web.Pages.Tableau.AnnonceModel
@{
    ViewData["Title"] = Model.Modification ? "Modifier l'annonce" : "Publier une annonce";
}

<section class="sec">
    <div class="env env-etroit">
        <p class="petit"><a asp-page="/Tableau/Index">Retour au tableau de bord</a></p>

        <div class="carte-forme carte-espacee">
            <h1 class="titre-page">@ViewData["Title"]</h1>

            <form class="forme forme-espacee" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Saisie.Id" />
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="duo">
                    <div class="champ">
                        <label asp-for="Saisie.Categorie"></label>
                        <select asp-for="Saisie.Categorie">
                            <option value="Chambre">Chambre</option>
                            <option value="Voiture">Voiture</option>
                        </select>
                    </div>
                    <div class="champ">
                        <label asp-for="Saisie.Exemplaires"></label>
                        <input asp-for="Saisie.Exemplaires" type="number" min="1" max="200" />
                        <span class="aide">Combien d'unités identiques vous louez sous cette annonce.</span>
                        <span asp-validation-for="Saisie.Exemplaires" class="text-danger"></span>
                    </div>
                </div>

                <div class="duo">
                    <div class="champ">
                        <label asp-for="Saisie.PrixJournalier"></label>
                        <input asp-for="Saisie.PrixJournalier" type="number" min="1" max="5000" placeholder="90"
                               value="@(Model.Saisie.PrixJournalier == 0 ? string.Empty : Model.Saisie.PrixJournalier.ToString())" />
                        <span asp-validation-for="Saisie.PrixJournalier" class="text-danger"></span>
                    </div>
                </div>

                <div class="champ">
                    <label asp-for="Saisie.Titre">Titre</label>
                    <input asp-for="Saisie.Titre" />
                    <span asp-validation-for="Saisie.Titre" class="text-danger"></span>
                </div>

                <div class="champ">
                    <label asp-for="Saisie.Description">Description</label>
                    <textarea asp-for="Saisie.Description"></textarea>
                    <span asp-validation-for="Saisie.Description" class="text-danger"></span>
                </div>

                <div class="duo">
                    <div class="champ">
                        <label asp-for="Fichier">Ajouter votre photo</label>
                        <input asp-for="Fichier" type="file" accept=".jpg,.jpeg,.png,.webp" />
                        <span class="aide">JPEG, PNG ou WebP, 4 Mo au maximum.</span>
                        <span asp-validation-for="Fichier" class="text-danger"></span>
                    </div>
                    <div class="champ">
                        <label asp-for="Saisie.Photo">Ou reprendre une photo du site</label>
                        <select asp-for="Saisie.Photo">
                            @foreach (string photo in Model.Photos)
                            {
                                <option value="@photo">@photo</option>
                            }
                        </select>
                        <span class="aide">Ignoré si vous téléversez un fichier.</span>
                    </div>
                </div>

                <fieldset id="bloc-chambre">
                    <div class="duo">
                        <div class="champ">
                            <label asp-for="Saisie.Superficie"></label>
                            <input asp-for="Saisie.Superficie" type="number" min="0" max="2000" />
                            <span asp-validation-for="Saisie.Superficie" class="text-danger"></span>
                        </div>
                        <div class="champ">
                            <label asp-for="Saisie.Couchages"></label>
                            <input asp-for="Saisie.Couchages" type="number" min="0" max="20" />
                            <span asp-validation-for="Saisie.Couchages" class="text-danger"></span>
                        </div>
                    </div>
                </fieldset>

                <fieldset id="bloc-voiture">
                    <div class="trio">
                        <div class="champ">
                            <label asp-for="Saisie.Marque">Marque</label>
                            <input asp-for="Saisie.Marque" />
                        </div>
                        <div class="champ">
                            <label asp-for="Saisie.Annee"></label>
                            <input asp-for="Saisie.Annee" type="number" min="1950" max="2100" />
                            <span asp-validation-for="Saisie.Annee" class="text-danger"></span>
                        </div>
                        <div class="champ">
                            <label asp-for="Saisie.Places"></label>
                            <input asp-for="Saisie.Places" type="number" min="0" max="12" />
                            <span asp-validation-for="Saisie.Places" class="text-danger"></span>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="champ">
                    <legend>Ce qui est inclus</legend>
                    <div class="equipements grand">
                        @foreach (Equipement equipement in Model.Equipements)
                        {
                            bool coche = Model.EquipementsChoisis.Contains(equipement.Id);
                            <label class="equip equip-cliquable" data-categorie="@equipement.Categorie">
                                <input type="checkbox" name="EquipementsChoisis" value="@equipement.Id"
                                       checked="@coche" class="case" />
                                <svg class="ico"><use href="#i-@equipement.Code" /></svg>
                                @equipement.Libelle
                            </label>
                        }
                    </div>
                </fieldset>

                <label class="equip equip-bascule">
                    <input asp-for="Saisie.EstDisponible" class="case-large" />
                    Visible sur le site public
                </label>

                <button class="btn btn-primaire" type="submit">
                    @(Model.Modification ? "Enregistrer les changements" : "Publier l'annonce")
                </button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/annonce.js" asp-append-version="true"></script>
}
